BOT_TOKEN=#your bot token goes here

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
BACKEND_URL=localhost:3000
# REDIS_USERNAME=
# REDIS_PASSWORD=
# INFLUXDB_TOKEN=your influxdb token goes here
# INFLUXDB_URL=http://localhost:8086

# Campaign spam protection. Start with observe, then quarantine, then enforce.
CAMPAIGN_SPAM_MODE=off
CAMPAIGN_SPAM_JOIN_GATE=false
CAMPAIGN_SPAM_CONFIRMED_SIGNATURES_JSON=[]
CAMPAIGN_SPAM_DENIED_USER_IDS_JSON=[]
CAMPAIGN_SPAM_DENIED_HANDLES_JSON=[]
CAMPAIGN_SPAM_DENIED_BUTTON_DOMAINS_JSON=[]
CAMPAIGN_SPAM_DENIED_VIA_BOT_IDS_JSON=[]
# Use a stable, random value of at least 32 characters. Falls back to BOT_TOKEN when omitted.
# CAMPAIGN_SPAM_FINGERPRINT_SECRET=
# CAMPAIGN_SPAM_QUARANTINE_DURATION=10m
# CAMPAIGN_SPAM_BURST_WINDOW_SECONDS=600
# CAMPAIGN_SPAM_BURST_AUTHOR_THRESHOLD=3
# CAMPAIGN_SPAM_BURST_CHAT_THRESHOLD=2
# CAMPAIGN_SPAM_FRESH_WINDOW_SECONDS=600
# CAMPAIGN_SPAM_EVIDENCE_RETENTION_SECONDS=2592000
# CAMPAIGN_SPAM_PENDING_MEMBER_SECONDS=86400
# CAMPAIGN_SPAM_PROFILE_AUTHOR_THRESHOLD=3
