BOT_TOKEN=#your bot token goes here

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
BACKEND_URL=localhost:3000
# REDIS_USERNAME=
# REDIS_PASSWORD=
# INFLUXDB_TOKEN=your influxdb token goes here
# INFLUXDB_URL=http://localhost:8086

# PoliNetwork IdP (required): the bot calls the backend only with its service token.
IDP_PUBLIC_URL=https://auth.polinetwork.org
# Optional transport URL inside the cluster; issuer/audience still use the public URL.
# IDP_INTERNAL_URL=http://auth:3000
OAUTH_BACKEND_RESOURCE_URI=https://backend.internal.polinetwork.org
OAUTH_BOT_CLIENT_ID=#registered telegram-bot client ID
# Private JWK JSON, with kid/alg/d; inject from the bot's Key Vault secret.
OAUTH_BOT_PRIVATE_JWK=#private JWK JSON
